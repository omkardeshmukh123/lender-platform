# ============================================================
# MITRAM360 — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Google Gemini ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_URL=https://your-project-ref.supabase.co

# JWT secret — REQUIRED. Find in Supabase dashboard → Project Settings → API → JWT Secret
# Server refuses to start if this is missing or shorter than 32 characters.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Database ─────────────────────────────────────────────────
# Development (port 5432 — direct, NOT for production):
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Production (port 6543 — PgBouncer pooler, REQUIRED for production):
# Using direct port 5432 in production will exhaust the connection limit.
# DATABASE_URL=postgresql://postgres:your-db-password@your-project-ref.pooler.supabase.com:6543/postgres

# ── FastAPI ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Never use * in production.
CORS_ORIGINS=http://localhost:3000
# API environment: production (disables /docs, /redoc, /openapi.json) or development
ENV=production

# DB connection pool — tuned for Supabase free tier (max 20 connections total).
# Budget: API=5, Airflow=5, Grafana=2, migrate.py=1, scheduler=1 → total 14 (safe).
# Use Supabase pooler (port 6543) if you need higher concurrency.
DB_POOL_MIN=2
DB_POOL_MAX=5
DB_COMMAND_TIMEOUT=30

# Cache TTLs in seconds (all configurable — no code redeploy needed to tune)
CACHE_TTL_MATCH=300
CACHE_TTL_SEARCH=120
CACHE_TTL_DETAIL=600
CACHE_TTL_STATS=300
CACHE_KEY_LENGTH=32

# Rate limiting (format: N/minute or N/hour)
RATE_SEARCH_PER_MIN=100/minute
RATE_MATCH_PER_MIN=30/minute
RATE_DETAIL_PER_MIN=200/minute

# ── Guardrails ───────────────────────────────────────────────
# Hard-reject floor: records below this are discarded entirely (0.0–1.0)
GUARDRAILS_MIN_QUALITY=0.20
# Review band upper bound: records between MIN_QUALITY and this go to needs_review (not rejected)
GUARDRAILS_REVIEW_FLOOR=0.40
# Confidence threshold above which is_non_lender triggers auto-reject (vs. flag for review)
GUARDRAILS_NON_LENDER_CONFIDENCE=0.90

# ── Gemini Pipeline ──────────────────────────────────────────
# Circuit breaker: open circuit after N consecutive failures
GEMINI_CIRCUIT_THRESHOLD=5
# Circuit breaker: keep circuit open for N seconds before retrying
GEMINI_CIRCUIT_RESET_S=300
# Retry: number of attempts per Gemini call
GEMINI_RETRY_ATTEMPTS=3
# Retry: initial delay in seconds between retries (doubles each attempt)
GEMINI_RETRY_DELAY_S=10.0
# Scraper request timeout in seconds
SCRAPER_TIMEOUT_S=30

# ── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=
# Fraction of requests to trace in Sentry (0.0–1.0). 0.10 = 10%.
SENTRY_TRACES_RATE=0.10

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=change-this-to-a-random-32-char-string
AIRFLOW_ADMIN_PASSWORD=change-this-password
# Airflow's internal metadata Postgres (NOT the main Supabase DB)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-this-airflow-db-password

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
GRAFANA_PG_HOST=db.your-project-ref.supabase.co
GRAFANA_PG_USER=postgres
GRAFANA_PG_PASSWORD=your-db-password

# ── Search API (optional) ────────────────────────────────────
SERPER_API_KEY=your-serper-api-key-here
